# Copy to .env and fill in. .env is not committed.

# PowerSchool parent portal. No second factor.
PS_USER=
PS_PASSWORD=
PS_LOGIN_URL=https://example.powerschool.com/public
# Optional. Used once to attach an existing database to this student's first name.
# Leave blank. Students are discovered from the parent account.
PS_STUDENT=

# UniFi Network integration API on the gateway. Header is X-API-KEY.
UNIFI_URL=https://unifi.example
UNIFI_SITE_ID=
UNIFI_API_KEY=
# Optional. Used once as the QoS prefix for PS_STUDENT. After that, set each student's prefix in admin.
# Pause and resume only. Never create or delete.
UNIFI_RULE_MATCH=

# Password for the admin pages. Session secret signs the login cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
