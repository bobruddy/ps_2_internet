# Copy to .env and fill in. .env is not committed.

# PowerSchool parent portal. No second factor.
PS_USER=
PS_PASSWORD=
PS_LOGIN_URL=https://example.powerschool.com/public
# First name as shown in the parent portal student switcher.
PS_STUDENT=

# UniFi Network integration API on the gateway. Header is X-API-KEY.
UNIFI_URL=https://unifi.example
UNIFI_SITE_ID=
UNIFI_API_KEY=
# QoS rules whose names start with this text. Pause and resume only. Never create or delete.
UNIFI_RULE_MATCH=

# Password for the admin pages. Session secret signs the login cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
